# LUXORA Environment Variables

# Database Connection (Supabase / PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:5432/postgres?pgbooster=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:5432/postgres"

# NextAuth / Auth.js Configuration
NEXTAUTH_SECRET="luxora-production-secret-key-change-in-prod-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Supabase Client & Storage
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-SUPABASE-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Resend Transactional Email
RESEND_API_KEY="re_123456789_your_resend_api_key"
RESEND_EMAIL_FROM="onboarding@resend.dev"

# OpenAI Integration
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# Sentry.io Error Monitoring
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_AUTH_TOKEN="sntrys_your_sentry_auth_token"
SENTRY_ORG="luxora-retail"
SENTRY_PROJECT="luxora-web"

# Store Configuration
NEXT_PUBLIC_STORE_NAME="LUXORA"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"
NEXT_PUBLIC_BANK_NAME="Luxora National Bank"
NEXT_PUBLIC_BANK_ACCOUNT_NAME="LUXORA RETAIL GROUP INC"
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER="1092-8837-4412-9901"
NEXT_PUBLIC_BANK_ROUTING_NUMBER="021000021"
NEXT_PUBLIC_BANK_SWIFT_CODE="LUXUS33XXX"
